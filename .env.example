APP_NAME=Efemeride
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fechas.afdeveloper.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=info

# SQLite: un archivo dentro del volumen. Sin base de datos externa que mantener.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database/database.sqlite

QUEUE_CONNECTION=database
CACHE_DRIVER=file
SESSION_DRIVER=file

# ---- Panel web ----
PANEL_USER=alan
PANEL_PASSWORD=cambia-esto

# ---- WAHA ----
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
# Tu numero, con codigo de pais y sufijo
WAHA_DEFAULT_CHAT_ID=573001112233@c.us
WAHA_COUNTRY_CODE=57
WAHA_SIMULATE_TYPING=true
# Quien puede darle ordenes al bot por chat (separados por coma)
WAHA_ADMIN_NUMBERS=573001112233
# Token que pones tambien en el webhook de WAHA (?token=...)
WAHA_WEBHOOK_SECRET=

# ---- Recordatorios ----
REMINDERS_TIMEZONE=America/Bogota
REMINDERS_DEFAULT_DAYS=7,1,0
REMINDERS_SEND_AT=08:00
REMINDERS_LEAP_FALLBACK=february
REMINDERS_DIGEST_ENABLED=true
REMINDERS_DIGEST_DAY=monday
REMINDERS_DIGEST_AT=07:30
REMINDERS_DIGEST_HORIZON=30

# ---- Mensajes con IA (opcional) ----
REMINDERS_AI_ENABLED=false
ANTHROPIC_API_KEY=
REMINDERS_AI_MODEL=claude-sonnet-4-6
